{
  "name": "vibeprint",
  "version": "0.6.0",
  "description": "Draw your architecture on an iPad; your coding agent reads it, marks it up, and tracks the build against it.",
  "type": "module",
  "license": "MIT",
  "author": "Viraat Das",
  "homepage": "https://vibeprint.viraat.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viraatdas/vibeprint.git"
  },
  "bugs": "https://github.com/viraatdas/vibeprint/issues",
  "keywords": [
    "architecture",
    "diagram",
    "sketch",
    "canvas",
    "apple-pencil",
    "ipad",
    "mcp",
    "claude-code",
    "codex",
    "coding-agent"
  ],
  "bin": {
    "vibeprint": "dist/cli.js"
  },
  "files": [
    "dist",
    "web/src/fonts/OFL.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n daemon,web \"tsx watch src/cli.ts serve --dev\" \"vite --config web/vite.config.ts\"",
    "build": "tsup && vite build --config web/vite.config.ts",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "start": "node dist/cli.js serve",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "perfect-freehand": "^1.2.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
