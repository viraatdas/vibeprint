  "notes": [
    {
      "title": "Startup fails closed",
      "text": "CLI polls every 150ms, 60s default. Error file, child exit or timeout raises an error that points to the log.",
      "source": "src/session.ts"
    },
    {
      "title": "Missing key blocks restore",
      "text": "If the configured key store or CRUMB_KEY can't supply the key, decryption throws KEY_UNAVAILABLE and launch fails.",
      "source": "src/crypto.ts"
    },
    {
      "title": "Autosave is best-effort",
      "text": "Saves every 30s by default, on SIGUSR2 and on SIGTERM/SIGINT. Failures are only logged. Closing the window skips a final save.",
      "source": "src/session.ts"
    }
